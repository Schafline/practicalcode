---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LargeHero from '../components/LargeHero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="page-container">
			<LargeHero />

			<div class="content-body">
				<h1>Building a Real ASP.NET Core Storefront from the Ground Up</h1>

				<p>
					Practical Code documents the design, development and evolution of a real ASP.NET Core storefront from the ground up. Rather than isolated
					examples, the articles follow an evolving codebase as new features,
					architectural decisions and business requirements emerge.
				</p>

				<p>
					Along the way you'll find practical guides covering C#, ASP.NET
					Core, Entity Framework, front-end development, software architecture,
					AI-assisted workflows, analytics and the realities of building and
					running an online business.
				</p>

				<h2>What You'll Find Here</h2>

				<ul>
				<li><strong>End-to-End Project Development:</strong> Follow a real storefront application as it evolves feature by feature.</li>

				<li><strong>Practical ASP.NET Core:</strong> Learn architecture, data modelling, APIs, Entity Framework and modern web development techniques.</li>

				<li><strong>Building a Real Business:</strong> See how technology, data, SEO, analytics and ecommerce come together in practice.</li>

				<li><strong>Source Code at Every Stage:</strong> Compare your implementation against tagged milestones in the accompanying GitHub repository.</li>
				</ul>

				<p>
					Check out the latest technical articles in the <a href="/blog">Blog</a>, or dive straight into the step-by-step guides. Let’s build something solid!
				</p>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ==========================================================================
	   Contentor Principal da Página (Alinha o Hero e o Texto a 900px)
	   ========================================================================== */
	.page-container {
		width: 100%;
		max-width: 900px;
		margin: 0 auto;
		padding: 1.5rem 1rem 4rem 1rem;
		box-sizing: border-box;
	}

	/* ==========================================================================
	   Corpo de Conteúdo (Alinhamento perfeito à esquerda do Hero)
	   ========================================================================== */
	.content-body {
		width: 100%;
		margin-top: 2.5rem;
		text-align: left;
	}

	/* Títulos */
	.content-body h1 {
		font-size: 2.25rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.25;
		margin: 0 0 1.25rem 0;
		letter-spacing: -0.02em;
	}

	.content-body h2 {
		font-size: 1.65rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.3;
		margin: 2.5rem 0 1rem 0;
	}

	/* Parágrafos */
	.content-body p {
		font-size: 1.1rem;
		line-height: 1.7;
		color: #334155;
		margin: 0 0 1.25rem 0;
	}

	/* Lista de Destaques */
	.feature-list {
		margin: 1rem 0 2rem 1.5rem;
		padding: 0;
		list-style-type: disc;
	}

	.feature-list li {
		font-size: 1.05rem;
		line-height: 1.65;
		color: #334155;
		margin-bottom: 0.6rem;
	}

	/* Links */
	.content-body a {
		color: #0284c7;
		text-decoration: underline;
		transition: color 0.2s ease;
	}

	.content-body a:hover {
		color: #0369a1;
	}
</style>
